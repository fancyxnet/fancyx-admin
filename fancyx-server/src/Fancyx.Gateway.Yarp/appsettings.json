{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ServiceMode": "Direct",
  "CorsOrigins": "http://localhost:8080",
  "Consul": {
    "Host": "http://localhost:8500",
    "Token": "99abbc21-ddaf-1cd4-a301-51c0df690841",
    "NodeName": "fancyx-gateway-yarp",
    "HttpPort": 9000
  },
  "ReverseProxy": {
    "Routes": {
      "admin": {
        "ClusterId": "fancyx-admin-api",
        "Match": {
          "Path": "/admin-api/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/admin-api" },
          { "PathPrefix": "/api" }
        ]
      },
      "erp": {
        "ClusterId": "fancyx-erp-api",
        "Match": {
          "Path": "/erp-api/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/erp-api" },
          { "PathPrefix": "/api" }
        ]
      }
    },
    "Clusters": {
      "fancyx-admin-api": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "fancyx-erp-api": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      }
    }
  }
}
