{
  "Routes": [
    {
      "UpstreamPathTemplate": "/admin-api/{url}",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ],
      "DownstreamPathTemplate": "/api/{url}"
    },
    {
      "UpstreamPathTemplate": "/File/{url}",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ],
      "DownstreamPathTemplate": "/File/{url}"
    },
    {
      "UpstreamPathTemplate": "/erp-api/{url}",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5002
        }
      ],
      "DownstreamPathTemplate": "/api/{url}"
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:9000",
    "CorsOptions": {
      "AllowCredentials": true,
      "AllowedOrigins": [
        "https://crackerwork.cn",
        "http://localhost:8080"
      ],
      "AllowedMethods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "AllowedHeaders": [
        "Content-Type",
        "Authorization",
        "X-Requested-With"
      ],
      "ExposedHeaders": [
        "Content-Disposition"
      ]
    }
  }
}
