{
  "Routes": [
    {
      "UpstreamPathTemplate": "/admin-api/{url}",
      "ServiceName": "fancyx-admin-api",
      "UseServiceDiscovery": true,
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "DownstreamPathTemplate": "/api/{url}"
    },
    {
      "UpstreamPathTemplate": "/File/{url}",
      "ServiceName": "fancyx-admin-api",
      "UseServiceDiscovery": true,
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "DownstreamPathTemplate": "/File/{url}"
    },
    {
      "UpstreamPathTemplate": "/erp-api/{url}",
      "ServiceName": "fancyx-erp-api",
      "UseServiceDiscovery": true,
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "DownstreamPathTemplate": "/api/{url}"
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:9000",
    "ServiceDiscoveryProvider": {
      "Host": "localhost",
      "Port": 8500,
      "Type": "Consul",
      "Token": "99abbc21-ddaf-1cd4-a301-51c0df690841",
      "UseOnlyHealthyServices": true
    },
    "CorsOptions": {
      "AllowCredentials": true,
      "AllowedOrigins": [
        "https://crackerwork.cn",
        "http://localhost:8080"
      ],
      "AllowedMethods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "AllowedHeaders": [
        "Content-Type",
        "Authorization",
        "X-Requested-With"
      ],
      "ExposedHeaders": [
        "Content-Disposition"
      ]
    }
  }
}
